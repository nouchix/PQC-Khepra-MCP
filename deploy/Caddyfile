# Caddyfile — reverse proxy for khepra-mcp
# Phase 1: Plain HTTP on port 80 (no TLS until DNS A record is configured)
# Phase 2: Uncomment mcp.souhimbou.ai block and remove :80 block for auto-TLS

:80 {
    reverse_proxy khepra-mcp:8080

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

