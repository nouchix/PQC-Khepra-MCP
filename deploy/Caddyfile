# Caddyfile — reverse proxy for khepra-mcp
# Caddy auto-provisions Let's Encrypt TLS for mcp.souhimbou.ai

mcp.souhimbou.ai {
    reverse_proxy khepra-mcp:8080

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Access-Control-Allow-Origin https://smithery.ai
    }
}
