# .env.vps.example — copy to /opt/khepra/.env on the VPS and fill in values
# Referenced by docker-compose.vps.yml via ${VAR} substitution

# ── Required ──────────────────────────────────────────────────────────────────
KHEPRA_SERVICE_SECRET=                   # Shared HMAC secret for service-to-service auth
                                          # Generate: openssl rand -hex 32

# ── Supabase (SouHimBou AI SaaS tier) ────────────────────────────────────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=               # Supabase service_role key (bypasses RLS)
SUPABASE_JWT_SECRET=                     # Supabase JWT secret (Settings → API)

# ── Optional ──────────────────────────────────────────────────────────────────
# LLM is auto-wired to local Ollama. If Ollama not running, NL queries degrade
# gracefully to keyword routing (no failure).
# LLM_URL=http://ollama:11434
# LLM_MODEL=llama3.1:8b
