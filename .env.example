# ── Supabase (Auth + DB) ──────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Legacy Vite vars (kept for compat while migrating)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# ── ASAF Backend / MCP Server ─────────────────────────────────────────────────
# Production VPS: 187.124.225.91 — mcp.souhimbou.ai
NEXT_PUBLIC_ASAF_API_URL=https://mcp.souhimbou.ai
NEXT_PUBLIC_ASAF_API_KEY=your-api-key-here

# ── App URL ───────────────────────────────────────────────────────────────────
# Production domain — used for Stripe redirect URLs and password reset emails
NEXT_PUBLIC_APP_URL=https://souhimbou.ai

# ── Stripe ────────────────────────────────────────────────────────────────────
# Server-side only — NEVER expose sk_... to the frontend
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

