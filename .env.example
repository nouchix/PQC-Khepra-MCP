# ── PQC-Khepra-MCP Open-Source Server — Environment Template ────────────────
# DO NOT COMMIT REAL SECRETS TO VCS. Copy this to .env and fill in real values.

# Server Mode (sovereign | airgap | community)
KHEPRA_MODE=sovereign
KHEPRA_NETWORK_POLICY=lan
MCP_PQC_ENABLED=true

# License Key (Community $0 requires no key)
KHEPRA_LICENSE_KEY=kphr_com_your-license-key-here

# Configurable Upgrade URL
KHEPRA_UPGRADE_URL=https://souhimbou.ai
