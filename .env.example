# Phantom Network Stack — environment variables
# Copy this file to .env and fill in every value before starting.
# NEVER commit .env to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────
# Strong random password required. Default placeholder will be rejected.
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Grafana ───────────────────────────────────────────────────────────
# Admin password for the Grafana dashboard (monitoring profile only).
# Generate with: openssl rand -base64 32
GRAFANA_ADMIN_PASSWORD=

# ── Phantom node ──────────────────────────────────────────────────────
# Optional: uncomment and set if phantom-node needs a DB connection
# DATABASE_URL=postgres://phantom:${POSTGRES_PASSWORD}@postgres:5432/phantom
