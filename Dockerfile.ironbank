# Dockerfile for ADINKHEPRA Protocol - PQC ASAF - Iron Bank Hardened
#
# Module: github.com/nouchix/PQC-Khepra-MCP
# SPDX-License-Identifier: LicenseRef-Proprietary
# Maintained by: NouchiX SecRed Knowledge Inc.
# Iron Bank Compliance: RHEL-09-STIG-V1R3

ARG BASE_REGISTRY=registry1.dso.mil
ARG BUILDER_IMAGE=ironbank/google/golang/golang
ARG BUILDER_TAG=1.23
ARG BASE_IMAGE=ironbank/redhat/ubi/ubi9-minimal
ARG BASE_TAG=9.5

# ============================================================================
# STAGE 1: Builder (Offline Build Environment)
# ============================================================================
FROM ${BASE_REGISTRY}/${BUILDER_IMAGE}:${BUILDER_TAG} AS builder

LABEL stage="builder"
LABEL maintainer="NouchiX SecRed Knowledge Inc."
LABEL description="ADINKHEPRA Protocol - Iron Bank Builder Stage"

ARG VERSION=1.0.0
ARG BUILD_DATE
ARG VCS_REF

USER root

ENV GOPATH=/go \
    GOCACHE=/go/cache \
    GOMODCACHE=/go/pkg/mod \
    CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=amd64 \
    GO111MODULE=on

RUN useradd -m -u 1001 -g 0 -s /sbin/nologin builder && \
    mkdir -p /go /build && \
    chown -R 1001:0 /go /build

WORKDIR /build

COPY --chown=1001:0 go.mod go.sum ./

RUN go mod download && go mod verify

COPY --chown=1001:0 . .

USER 1001

# Build all binaries in a single layer with security hardening flags
RUN go build \
        -mod=mod -trimpath \
        -ldflags="-s -w -X main.VERSION=${VERSION} -X main.BUILD_DATE=${BUILD_DATE} -X main.VCS_REF=${VCS_REF} -extldflags '-static'" \
        -tags=netgo -o sonar ./cmd/sonar/main.go && \
    go build \
        -mod=mod -trimpath \
        -ldflags="-s -w -X main.version=${VERSION} -X main.buildDate=${BUILD_DATE} -extldflags '-static'" \
        -tags=netgo -o adinkhepra ./cmd/adinkhepra/main.go && \
    go build \
        -mod=mod -trimpath \
        -ldflags="-s -w -extldflags '-static'" \
        -tags=netgo -o khepra-daemon ./cmd/khepra-daemon/main.go && \
    go build \
        -mod=mod -trimpath \
        -ldflags="-s -w -extldflags '-static'" \
        -tags=netgo -o nouchix-agent ./cmd/agent/main.go && \
    go build \
        -mod=mod -trimpath \
        -ldflags="-s -w -extldflags '-static'" \
        -tags=netgo -o nouchix-stig ./cmd/stig-test/main.go

# ============================================================================
# STAGE 2: Runtime (Minimal UBI9 - Attack Surface Reduction)
# ============================================================================
FROM ${BASE_REGISTRY}/${BASE_IMAGE}:${BASE_TAG} AS runtime

ARG VERSION=1.0.0
ARG BUILD_DATE
ARG VCS_REF

LABEL org.opencontainers.image.title="KHEPRA MCP Server - Iron Bank" \
      org.opencontainers.image.description="Sovereign PQC compliance engine for DoD/IC. 36195 STIG/CCI/NIST/CMMC mappings." \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/nouchix/PQC-Khepra-MCP" \
      org.opencontainers.image.licenses="LicenseRef-Proprietary" \
      io.modelcontextprotocol.server.name="pqc-khepra-mcp" \
      io.modelcontextprotocol.server.version="${VERSION}" \
      maintainer="NouchiX SecRed Knowledge Inc."

RUN microdnf update -y && \
    microdnf install -y ca-certificates shadow-utils && \
    microdnf clean all && \
    useradd -m -u 1001 -g 0 -s /sbin/nologin khepra && \
    mkdir -p /var/lib/khepra /var/log/khepra && \
    chown -R 1001:0 /var/lib/khepra /var/log/khepra

COPY --from=builder --chown=1001:0 /build/adinkhepra /usr/local/bin/adinkhepra
COPY --from=builder --chown=1001:0 /build/sonar /usr/local/bin/nouchix-sonar
COPY --from=builder --chown=1001:0 /build/khepra-daemon /usr/local/bin/khepra-daemon
COPY --from=builder --chown=1001:0 /build/nouchix-agent /usr/local/bin/nouchix-agent
COPY --from=builder --chown=1001:0 /build/nouchix-stig /usr/local/bin/nouchix-stig

USER 1001

WORKDIR /var/lib/khepra

ENV KHEPRA_MODE=sovereign \
    KHEPRA_HOME=/var/lib/khepra \
    KHEPRA_LOG_DIR=/var/log/khepra

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["/usr/local/bin/adinkhepra", "health"]

ENTRYPOINT ["/usr/local/bin/adinkhepra"]
CMD ["serve", "--mode", "mcp"]
