{
  "_comment": "KHEPRA MCP Client Config — SOVEREIGN / AIR-GAP MODE with Cloudflare MCP Integration.",
  "mcpServers": {
    "pqc-khepra-mcp": {
      "command": "go",
      "args": [
        "run",
        "/Applications/Whitebox/PQC-Khepra-MCP/cmd/khepra-mcp/main.go"
      ],
      "env": {
        "KHEPRA_MODE": "sovereign",
        "KHEPRA_NETWORK_POLICY": "lan",
        "KHEPRA_SERVICE_SECRET": "${KHEPRA_SERVICE_SECRET}",
        "MCP_PQC_ENABLED": "true"
      }
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "cloudflare-docs": {
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "cloudflare-bindings": {
      "url": "https://bindings.mcp.cloudflare.com/mcp"
    },
    "cloudflare-builds": {
      "url": "https://builds.mcp.cloudflare.com/mcp"
    },
    "cloudflare-observability": {
      "url": "https://observability.mcp.cloudflare.com/mcp"
    }
  }
}
